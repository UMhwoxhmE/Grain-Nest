{
  "name": "grain-nest",
  "version": "1.4.0",
  "description": "Pattern nesting for dressmaking — fork of deepnest-next adding grain-direction constraints",
  "private": true,
  "main": "main.js",
  "types": "index.d.ts",
  "license": "MIT",
  "scripts": {
    "prestart": "tsc",
    "start": "electron .",
    "printenv": "cross-replace node -e \"console.log(process.env)\"",
    "test": "playwright test",
    "build": "tsc",
    "postinstall": "tsc",
    "rebuild-native": "electron-builder install-app-deps",
    "clean": "rm -rf build dist out",
    "clean-all": "rm -rf build dist out node_modules bin",
    "dist": "electron-packager . Grain-Nest --platform=darwin --arch=arm64 --icon=icon.icns --app-bundle-id=com.grainnest.app --out=out --overwrite --ignore='\\.github' --ignore='\\.vscode' --ignore='\\.husky' --ignore='\\.claude' --ignore='^/out' --ignore='^/docs' --ignore='^/tests' --ignore='^/helper_scripts' --ignore='^/examples' --ignore='^/playwright-report' --ignore='^/test-results' --ignore='renovate\\.json' --ignore='\\.readthedocs\\.yaml' --ignore='CHANGELOG\\.md' --ignore='\\.gitignore' --ignore='\\.gitattributes' --ignore='test\\.log' --ignore='\\.command$' --ignore='setup-mac\\.sh' --ignore='^/grainnest' --ignore='\\.tsbuildinfo$' && codesign --force --deep --sign - out/Grain-Nest-darwin-arm64/Grain-Nest.app",
    "dist-all": "npm run clean-all && npm install && npm run build && npm run dist",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "pw:codegen": "node helper_scripts/playwright_codegen.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{ts,html,css,scss,less,json}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  },
  "repository": "https://github.com/UMhwoxhmE/Grain-Nest",
  "keywords": [
    "Electron",
    "Nesting",
    "Dressmaking",
    "Sewing",
    "Pattern"
  ],
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "@electron/rebuild": "^4.0.2",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "22.15.17",
    "cross-replace": "0.2.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.26.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "dependencies": {
    "@deepnest/calculate-nfp": "202503.13.155300",
    "@deepnest/svg-preprocessor": "0.2.0",
    "@electron/remote": "2.1.3",
    "axios": "1.13.2",
    "form-data": "4.0.5",
    "graceful-fs": "4.2.11",
    "marked": "17.0.1"
  },
  "files": [
    "main.js",
    "main/**/*",
    "index.d.ts",
    "node_modules",
    "package.json",
    "icon.icns"
  ],
  "build": {
    "appId": "com.grainnest.app",
    "copyright": "2026 Grain-Nest contributors. Forked from deepnest-next.",
    "nodeGypRebuild": false,
    "files": [
      "**/*",
      "build/**/*.js",
      "!**/grain-nest-v*",
      "!**/deepnest-v*",
      "!**/out",
      "!**/playwright-*",
      "!**/test*",
      "!**/*.ts",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/package-lock.json",
      "!test**",
      "!.readthedocs.yaml",
      "!**/._*",
      "!{examples,helper_scripts}",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.vscode,.husky,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "directories": {
      "app": ".",
      "output": "out"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "icon.icns"
    }
  },
  "contributors": [
    {
      "name": "Josef Fröhle",
      "email": "github@josef-froehle.de"
    }
  ]
}
